{
	"name": "kept",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.6.2",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "pnpm --filter @kept/web dev",
		"build": "pnpm --filter @kept/web build",
		"start": "pnpm --filter @kept/web start",
		"lint": "eslint . --max-warnings=0",
		"typecheck": "pnpm -r typecheck",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --test \"scripts/*.test.mjs\" && pnpm -r test",
		"test:e2e": "pnpm --filter @kept/web test:e2e",
		"prisma:generate": "pnpm --filter @kept/web prisma:generate",
		"prisma:migrate:generate:check": "pnpm --filter @kept/web prisma:migrate:generate:check",
		"db:run-once": "pnpm --filter @kept/web db:run-once",
		"check:env": "pnpm --filter @kept/web check:env",
		"check:secrets": "node scripts/check-secrets.mjs --all",
		"check:standards": "node scripts/check-standards.mjs",
		"check:template": "node scripts/check-template-clean.mjs",
		"check:rls": "pnpm --filter @kept/web check:rls",
		"check:ai-models": "pnpm --filter @kept/web check:ai-models",
		"prepare": "git config core.hooksPath .githooks",
		"eval:planner": "pnpm --filter @kept/web eval:planner"
	},
	"devDependencies": {
		"eslint": "^9",
		"eslint-config-next": "^16.4.5",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"@sentry/cli",
			"@swc/core",
			"prisma",
			"unrs-resolver"
		]
	}
}
