// Act's half of the schema (docs/product/tasks.md). Learn's tables live in
// learn.prisma. New tables here need the RLS migration: docs/rules/auth.md.
//
// User.id is NOT @default — per docs/rules/auth.md, this template's convention
// is that User.id IS the Supabase auth user's uuid, set explicitly when the row
// is first created (provisionUser, on first sign-up or sign-in), never generated
// app-side. @db.Uuid matches AdminMember.userId @db.Uuid
// (prisma/schema/authz.prisma) so the FK types agree.
//
// The money numbers and first reminder time are null until setup asks for them.
// timeZone is set once, by provisionUser; the default covers rows made before
// it existed and matches the fallback in src/lib/kept-day.ts.
model User {
	id                 String       @id @db.Uuid
	email              String       @unique
	incomePence        Int?         @map("income_pence")
	costsPence         Int?         @map("costs_pence")
	savingsPence       Int?         @map("savings_pence")
	timeZone           String       @default("Europe/London") @map("time_zone")
	firstReminderTime  String?      @map("first_reminder_time")
	isCountedInResults Boolean      @default(true) @map("is_counted_in_results")
	isDemo             Boolean      @default(false) @map("is_demo")
	createdAt          DateTime     @default(now()) @db.Timestamptz(6)
	updatedAt          DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
	adminMember        AdminMember?
	events             Event[]
	promises           Promise[]
	// Learn's side (learn.prisma). Prisma needs both ends of a relation.
	goal               Goal?
	plan               Plan?
	reviews            Review[]
	recallAttempts     RecallAttempt[]

	@@map("users")
}

// Append-only, written only through recordEvent (src/server/events/record-event.ts),
// which holds the typed list of names and the contract for details.
//
// uuid(7) ids are time-ordered, so inserts land at the end of the primary key
// index instead of all over it, which keeps a table that only grows fast.
// A repeated submission carries the same idempotencyKey and the unique index
// keeps one row, even when two arrive at once. Postgres treats NULLs as
// distinct, so Events without a key never clash.
model Event {
	id             String   @id @default(uuid(7)) @db.Uuid
	userId         String   @map("user_id") @db.Uuid
	name           String
	keptDay        DateTime @map("kept_day") @db.Date
	occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
	details        Json     @default("{}") @db.JsonB
	idempotencyKey String?  @map("idempotency_key")
	user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@unique([userId, idempotencyKey])
	@@index([userId, keptDay])
	@@index([name, keptDay])
	@@map("events")
}

enum PromiseSize {
	small
	medium
	large
}

enum PromiseMoment {
	wake_up
	lunch
	after_work
	before_bed
}

// One Action on one Kept day (GLOSSARY.md). Wording and size are copied in when
// it's made, so it stays what the user promised. It can only be rewritten until
// the 4am after it's made, with a promise_changed Event. A Typed promise has no
// planActionId or size. The moment is kept apart so a screen can word the sentence.
model Promise {
	id           String        @id @default(uuid(7)) @db.Uuid
	userId       String        @map("user_id") @db.Uuid
	promiseDay   DateTime      @map("promise_day") @db.Date
	planActionId String?       @map("plan_action_id") @db.Uuid
	size         PromiseSize?
	wording      String        @db.VarChar(160)
	moment       PromiseMoment
	createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
	user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
	planAction   PlanAction?   @relation(fields: [planActionId], references: [id], onDelete: Cascade)
	reports      Report[]

	@@unique([userId, promiseDay])
	@@index([planActionId])
	@@map("promises")
}

enum ReportAnswer {
	yes
	partly
	no
}

// Added to, never edited: the latest row for a Promise is the one that counts.
// The id comes from the screen that asked, so a repeated submission saves once
// (ADR 0002).
model Report {
	id        String       @id @db.Uuid
	promiseId String       @map("promise_id") @db.Uuid
	answer    ReportAnswer
	createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
	promise   Promise      @relation(fields: [promiseId], references: [id], onDelete: Cascade)

	@@index([promiseId, createdAt])
	@@map("reports")
}
