{
	"cli": {
		"version": ">= 18.0.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development",
			"channel": "development"
		},
		"preview": {
			"channel": "preview",
			"distribution": "internal",
			"environment": "preview",
			"android": { "buildType": "apk" }
		},
		"simulator": {
			"extends": "preview",
			"ios": { "simulator": true },
			"env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
		},
		"production": {
			"channel": "production",
			"autoIncrement": true,
			"environment": "production",
			"android": { "buildType": "app-bundle" }
		}
	},
	"submit": {
		"production": {}
	}
}
