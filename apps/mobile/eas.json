{
	"cli": {
		"version": ">= 18.0.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development"
		},
		"preview": {
			"channel": "preview",
			"distribution": "internal",
			"environment": "preview",
			"android": { "buildType": "apk" }
		},
		"production": {
			"channel": "production",
			"autoIncrement": true,
			"environment": "production",
			"android": { "buildType": "app-bundle" }
		}
	},
	"submit": {
		"production": {}
	}
}
