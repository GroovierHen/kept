# The mobile app's environment. Copy to .env.local for local runs; builds and
# updates read EAS environment variables (development / preview / production)
# instead. Everything here ships inside the app and anyone can read it, so
# only public client keys belong here — never a secret.
#
# Read in one place, src/lib/env.ts. Unset, blank or REPLACE_… means
# "not configured": the feature that needs it turns itself off.

# The web app (apps/web) the phone calls for all of its data (/api/app/v1).
# On a simulator, http://localhost:3000 reaches `pnpm dev` on this machine.
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# The same Supabase project as the web app: its URL and publishable key
# (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY there).
EXPO_PUBLIC_SUPABASE_URL=REPLACE_WITH_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# Error reporting. A mobile project's DSN in the same Sentry organisation.
EXPO_PUBLIC_SENTRY_DSN=

# Product analytics: the same PostHog project as the web app.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
