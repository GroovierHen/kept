// Generated into the app, not node_modules (Prisma 7). TypeScript output with
// .ts import specifiers, so Node's type stripping can load it from the
// scripts and node:test suites as well as through Next's bundler.
generator client {
	provider               = "prisma-client"
	output                 = "../../src/generated/prisma"
	runtime                = "nodejs"
	moduleFormat           = "esm"
	generatedFileExtension = "ts"
	importFileExtension    = "ts"
}

// Connection URLs live in prisma.config.ts (the CLI) and
// src/server/db/create-client.ts (the app) as of Prisma 7.
datasource db {
	provider = "postgresql"
}
