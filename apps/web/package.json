{
	"name": "@kept/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test \"scripts/*.test.mjs\" \"src/**/*.test.mts\"",
		"test:e2e": "playwright test",
		"prisma:generate": "prisma generate",
		"prisma:migrate:generate:check": "node scripts/generate-migration.mjs --check",
		"db:run-once": "node scripts/run-once-sql.mjs",
		"check:env": "node scripts/check-env-vars.mjs",
		"check:rls": "node scripts/check-rls.mjs",
		"check:ai-models": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/check-ai-models.mjs",
		"postinstall": "prisma generate",
		"eval:planner": "node --conditions=react-server --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/eval-planner.mts",
		"test-account:exclude": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/test-account.mts exclude",
		"test-account:jump": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/test-account.mts jump",
		"test-account:status": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/test-account.mts status"
	},
	"dependencies": {
		"@kept/brand": "workspace:^",
		"@kept/contract": "workspace:^",
		"@phosphor-icons/react": "^2.1.10",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-toast": "^1.3.1",
		"@sentry/nextjs": "^11.10.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"@tanstack/react-query": "^5.105.3",
		"@vercel/analytics": "^2.0.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"next": "^16.4.5",
		"next-intl": "^4.14.9",
		"pino": "^10.4.0",
		"posthog-js": "^1.445.1",
		"posthog-node": "^5.61.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-error-boundary": "^6.1.6",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@tailwindcss/postcss": "^4.3.4",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"prisma": "^7.10.1",
		"server-only": "^0.0.1",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3"
	}
}
