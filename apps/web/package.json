{
	"name": "@kept/web",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.18.0"
	},
	"prisma": {
		"schema": "prisma/schema"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test \"scripts/*.test.mjs\" \"src/**/*.test.mts\"",
		"test:e2e": "playwright test",
		"prisma:generate": "prisma generate",
		"prisma:migrate:generate:check": "node scripts/generate-migration.mjs --check",
		"db:run-once": "node scripts/run-once-sql.mjs",
		"check:env": "node scripts/check-env-vars.mjs",
		"check:rls": "node scripts/check-rls.mjs",
		"check:ai-models": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/check-ai-models.mjs",
		"postinstall": "prisma generate",
		"eval:planner": "node --conditions=react-server --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/eval-planner.mts"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@prisma/client": "^6.19.3",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-toast": "^1.2.23",
		"@sentry/nextjs": "^10.70.0",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.3",
		"@tanstack/react-query": "^5.101.4",
		"@vercel/analytics": "^2.0.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"next": "^16.4.3",
		"next-intl": "^4.13.6",
		"pino": "^10.3.1",
		"posthog-js": "^1.415.4",
		"posthog-node": "^5.48.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.3",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "^1.0.0",
		"prisma": "^6.19.3",
		"server-only": "^0.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.8.3"
	}
}
